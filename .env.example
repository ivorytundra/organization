# Copy this file to `.env.local` and fill in the values.
#
# 1. Create an OAuth client in Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
#    - Application type: "Web application"
#    - Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 2. Enable the Gmail API and Google Calendar API for the project:
#    https://console.cloud.google.com/apis/library
# 3. On the OAuth consent screen, add these scopes:
#    - .../auth/gmail.readonly
#    - .../auth/calendar.readonly
#    (while in "Testing", add your own account under "Test users")

# From the OAuth client you created above
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret

# A random secret used to encrypt the session. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# The canonical URL of the app. Leave as-is for local development.
AUTH_URL=http://localhost:3000
